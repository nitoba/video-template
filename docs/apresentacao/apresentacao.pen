              "type": "text",
              "id": "ogsLD",
              "name": "Linhas",
              "fill": "#F3E6DA",
              "content": "import {useCurrentFrame, interpolate}\n  from 'remotion';\n\nexport const Ola = () => {\n  const f = useCurrentFrame();\n  const o = interpolate(f, [0, 30], [0, 1]);\n  const y = interpolate(f, [0, 30], [40, 0]);\n  return <h1 style={{\n    opacity: o,\n    transform: `translateY(${y}px)`,\n  }}>Olá</h1>;\n};",
              "lineHeight": 1.55,
              "fontFamily": "$mono",
              "fontSize": 26
            }
          ]
        }
